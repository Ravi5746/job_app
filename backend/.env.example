# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="AI Job Automation Platform"
API_V1_STR="/api/v1"

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-at-least-32-chars

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_automation

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS middleware
# CORS_ORIGINS=["http://localhost:4000","http://localhost:3000"]

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: groq | ollama | openrouter
LLM_PROVIDER=groq

# Groq (recommended — free tier supports 70B + 8B with fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_SMART=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Ollama (local — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3:70b

# OpenRouter
# OPENAI_API_KEY=your-openrouter-api-key
# OPENAI_MODEL=openai/gpt-oss-20b

# Tinyfish (future use)
# TINYFISH_API_KEY=

# ── Groq Rate Limits ──────────────────────────────────────────────────────────
# GROQ_REQUESTS_PER_SECOND=0.4
# GROQ_MAX_BUCKET_SIZE=3

# ── Agent Behaviour ────────────────────────────────────────────────────────────
# MAX_FORM_STEPS=15
# MAX_FILL_RETRIES=2
# LLM_TIMEOUT_SECS=12.0
# LLM_MAX_TOKENS=1000

# ── Scraping (JSearch via RapidAPI) ───────────────────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_HOST=jsearch.p.rapidapi.com

# ── Browser (Playwright) ──────────────────────────────────────────────────────
# Set to true for headless (no visible browser window)
HEADLESS=false
# USER_DATA_DIR=~/.job_applied_browser_data
# SCREENSHOTS_DIR=~/.job_applied_screenshots
# UPLOAD_DIR=~/.job_applied_uploads

# ── Internal API (for resume downloads during automation) ─────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Observability (LangSmith tracing) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-applied-automation

# ── Feature Flags ─────────────────────────────────────────────────────────────
# ENABLE_QA_CACHE=true
# ENABLE_SEMANTIC_CLASSIFIER=true
